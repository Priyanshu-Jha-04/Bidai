{
  "info": {
    "name": "Bid.ai API",
    "description": "Node.js + PostgreSQL API for the Bid.ai app. Firebase Authentication issues the ID token; this API verifies it.\n\nHow to use: 1) set firebaseApiKey, email, password. 2) run \"0. Firebase\" to get idToken. 3) run \"Auth - Signup\" once, then the Products requests top to bottom.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{idToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "firebaseApiKey",
      "value": ""
    },
    {
      "key": "email",
      "value": "asha@example.com"
    },
    {
      "key": "password",
      "value": "Passw0rd!"
    },
    {
      "key": "idToken",
      "value": ""
    },
    {
      "key": "productId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "0. Firebase (get idToken)",
      "description": "Firebase owns the passwords. Run one of these first: it stores the ID token in {{idToken}}, which every other request sends as a Bearer token.",
      "item": [
        {
          "name": "Firebase - Sign up",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('idToken', pm.response.json().idToken);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Creates the Firebase account (email/password). Then call \"Auth - Signup\" to create the profile.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"returnSecureToken\": true\n}"
            },
            "url": "https://identitytoolkit.googleapis.com/v1/accounts:signUp?key={{firebaseApiKey}}"
          }
        },
        {
          "name": "Firebase - Sign in",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('idToken', pm.response.json().idToken);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Signs an existing account in and refreshes {{idToken}} (tokens expire after 1 hour).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"returnSecureToken\": true\n}"
            },
            "url": "https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key={{firebaseApiKey}}"
          }
        }
      ]
    },
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Auth - Signup (create profile)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 or 200', () => pm.expect([200, 201]).to.include(pm.response.code));",
                  "pm.test('returns user', () => pm.expect(pm.response.json().user.email).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Asha Verma\",\n  \"phone\": \"9876543210\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/signup"
          }
        },
        {
          "name": "Auth - Login (get profile)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('returns user', () => pm.expect(pm.response.json().user.email).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login"
          }
        }
      ]
    },
    {
      "name": "2. Products",
      "item": [
        {
          "name": "Products - Create (Sell)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('productId', pm.response.json().product.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "description": "multipart/form-data. Attach up to 5 files under the key \"images\".",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "Honda City 2018",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "Single owner, well maintained.",
                  "type": "text"
                },
                {
                  "key": "price",
                  "value": "650000",
                  "type": "text"
                },
                {
                  "key": "category",
                  "value": "Cars",
                  "type": "text"
                },
                {
                  "key": "condition",
                  "value": "used",
                  "type": "text"
                },
                {
                  "key": "brand",
                  "value": "Honda",
                  "type": "text"
                },
                {
                  "key": "productType",
                  "value": "Sedan",
                  "type": "text"
                },
                {
                  "key": "sellerType",
                  "value": "individual",
                  "type": "text"
                },
                {
                  "key": "location",
                  "value": "Bengaluru",
                  "type": "text"
                },
                {
                  "key": "images",
                  "type": "file",
                  "src": [],
                  "description": "JPEG/PNG, max 5 MB each, up to 5"
                }
              ]
            },
            "url": "{{baseUrl}}/api/products"
          }
        },
        {
          "name": "Products - Create (validation error)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('field errors', () => pm.expect(pm.response.json().fields).to.have.property('category'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "ab",
                  "type": "text"
                },
                {
                  "key": "price",
                  "value": "0",
                  "type": "text"
                },
                {
                  "key": "category",
                  "value": "Nope",
                  "type": "text"
                }
              ]
            },
            "url": "{{baseUrl}}/api/products"
          }
        },
        {
          "name": "Products - List (search / category / brand)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('has products array', () => pm.expect(pm.response.json().products).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/products?search=&category=All&brand=&page=1&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ],
              "query": [
                {
                  "key": "search",
                  "value": ""
                },
                {
                  "key": "category",
                  "value": "All"
                },
                {
                  "key": "brand",
                  "value": ""
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "Products - Mine",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products/mine"
          }
        },
        {
          "name": "Products - Categories",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('15 categories', () => pm.expect(pm.response.json().categories).to.have.length(15));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products/categories"
          }
        },
        {
          "name": "Products - Brands",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('has brands array', () => pm.expect(pm.response.json().brands).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/products/brands?category=Cars",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products",
                "brands"
              ],
              "query": [
                {
                  "key": "category",
                  "value": "Cars"
                }
              ]
            }
          }
        },
        {
          "name": "Products - Detail",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products/{{productId}}"
          }
        },
        {
          "name": "Products - Mark sold",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is sold', () => pm.expect(pm.response.json().product.status).to.eql('sold'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/products/{{productId}}/sold"
          }
        },
        {
          "name": "Products - Delete",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/products/{{productId}}"
          }
        }
      ]
    },
    {
      "name": "Health",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    }
  ]
}