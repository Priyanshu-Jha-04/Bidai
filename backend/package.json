{
  "name": "bidai-backend",
  "version": "1.0.0",
  "description": "REST API for the Bid.ai Android app (Node.js + Express + PostgreSQL)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:db": "node scripts/dev-db.js",
    "dev:local": "node scripts/dev-all.js",
    "seed": "node scripts/seed.js",
    "test": "node --test --test-force-exit test/api.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jose": "^5.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "embedded-postgres": "18.4.0-beta.17"
  }
}
